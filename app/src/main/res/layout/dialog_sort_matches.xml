<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_match_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sort Matches"
        android:textColor="@color/ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/radioGroupSort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <RadioButton
            android:id="@+id/radioLatest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Latest first"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:buttonTint="@color/zpl_blue" />

        <RadioButton
            android:id="@+id/radioOldest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Oldest first"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:buttonTint="@color/zpl_blue" />

        <RadioButton
            android:id="@+id/radioHighest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Highest score"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:buttonTint="@color/zpl_blue" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="CANCEL"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnApplySort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_cta_red"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="APPLY"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
