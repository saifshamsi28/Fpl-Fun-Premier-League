<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_leaderboard_page"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="44dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_round_blue"
            android:contentDescription="back"
            android:padding="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Leaderboard"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/leaderboardContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_leaderboard_top_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Global Ranked Standings"
                        android:textColor="#EAF3FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtYourRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Your Rank: --"
                        android:textColor="#FFD857"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_leaderboard_tab_strip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/tabAllTime"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_leaderboard_tab_active"
                            android:gravity="center"
                            android:text="All Time"
                            android:textColor="#0A2E58"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tabWeekly"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_leaderboard_tab_inactive"
                            android:gravity="center"
                            android:text="Weekly"
                            android:textColor="#B8D5FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tabMonthly"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_leaderboard_tab_inactive"
                            android:gravity="center"
                            android:text="Monthly"
                            android:textColor="#B8D5FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="214dp"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/podiumSecondSlot"
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="24dp"
                            android:elevation="4dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="4dp">

                            <TextView
                                android:id="@+id/podiumSecondRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="#2"
                                android:textColor="#D8E9FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/podiumSecondAvatar"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_leaderboard_podium_avatar_side"
                                android:gravity="center"
                                android:text="-"
                                android:textColor="#FFCF50"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="A" />

                            <TextView
                                android:id="@+id/podiumSecondName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:maxLines="1"
                                android:text="-"
                                android:textColor="#EAF3FF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="anwar" />

                            <TextView
                                android:id="@+id/podiumSecondRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="#FFD857"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="74.2%" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/podiumThirdSlot"
                            android:layout_width="130dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="24dp"
                            android:elevation="4dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingTop="4dp">

                            <TextView
                                android:id="@+id/podiumThirdRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="#3"
                                android:textColor="#D8E9FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/podiumThirdAvatar"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_leaderboard_podium_avatar_side"
                                android:gravity="center"
                                android:text="-"
                                android:textColor="#FFCF50"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                tools:text="S" />

                            <TextView
                                android:id="@+id/podiumThirdName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:maxLines="1"
                                android:text="-"
                                android:textColor="#EAF3FF"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="sarfraz" />

                            <TextView
                                android:id="@+id/podiumThirdRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="#FFD857"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="63.0%" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/podiumFirstSlot"
                            android:layout_width="170dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:elevation="12dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_trophy"
                                app:tint="#FFD857" />

                            <TextView
                                android:id="@+id/podiumFirstRank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="#1"
                                android:textColor="#EAF3FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/podiumFirstAvatar"
                                android:layout_width="104dp"
                                android:layout_height="104dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_leaderboard_podium_avatar_first"
                                android:gravity="center"
                                android:text="-"
                                android:textColor="#FFD04A"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                tools:text="S" />

                            <TextView
                                android:id="@+id/podiumFirstName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:maxLines="1"
                                android:text="-"
                                android:textColor="#F3F9FF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="saif" />

                            <TextView
                                android:id="@+id/podiumFirstRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#FFD857"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="83.3%" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tableContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_leaderboard_table_shell"
                    android:orientation="vertical"
                    android:paddingTop="9dp">

                    <HorizontalScrollView
                        android:id="@+id/tableScroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:scrollbars="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="8dp"
                                android:background="@drawable/bg_leaderboard_table_header"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="10dp">

                                <TextView
                                    android:id="@+id/headerRank"
                                    android:layout_width="96dp"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:drawableEnd="@drawable/ic_sort_split"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Rank"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/headerName"
                                    android:layout_width="214dp"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="start|center_vertical"
                                    android:drawableEnd="@drawable/ic_sort_split"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Name"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/headerWinRate"
                                    android:layout_width="102dp"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:drawableEnd="@drawable/ic_sort_split"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Win %"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/headerPlayed"
                                    android:layout_width="110dp"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:drawableEnd="@drawable/ic_sort_split"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Matches"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/headerWon"
                                    android:layout_width="90dp"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:drawableEnd="@drawable/ic_sort_split"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Won"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/headerRuns"
                                    android:layout_width="90dp"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:drawableEnd="@drawable/ic_sort_split"
                                    android:drawablePadding="4dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="Runs"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="160dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="start|center_vertical"
                                    android:paddingHorizontal="8dp"
                                    android:text="Team"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="126dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="start|center_vertical"
                                    android:paddingHorizontal="8dp"
                                    android:text="City"
                                    android:textColor="#D2E7FF"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerLeaderboard"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:clipToPadding="false"
                                android:nestedScrollingEnabled="false"
                                android:paddingHorizontal="8dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="16dp"
                                tools:listitem="@layout/item_leaderboard" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="No leaderboard data"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="36dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
