<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_color="@color/shimmer_base"
    app:shimmer_highlight_color="@color/shimmer_highlight"
    app:shimmer_duration="1200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_match_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <!-- Top: avatars + names + score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_blue"
                android:backgroundTint="@color/shimmer_base"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">
                <View
                    android:layout_width="60dp"
                    android:layout_height="14dp"
                    android:background="@color/shimmer_base"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/shimmer_base"/>
            </LinearLayout>

            <View
                android:layout_width="20dp"
                android:layout_height="11dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/shimmer_base"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:gravity="end"
                android:orientation="vertical">
                <View
                    android:layout_width="60dp"
                    android:layout_height="14dp"
                    android:background="@color/shimmer_base"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/shimmer_base"/>
            </LinearLayout>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_blue"
                android:backgroundTint="@color/shimmer_base"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#11000000"/>

        <!-- Bottom: badge + mode + date + chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="40dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_stat_pill"
                android:backgroundTint="@color/shimmer_base"/>
            <View
                android:layout_width="50dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:background="@color/shimmer_base"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <View
                android:layout_width="30dp"
                android:layout_height="11dp"
                android:background="@color/shimmer_base"/>
            <View
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:background="@color/shimmer_base"/>
        </LinearLayout>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
