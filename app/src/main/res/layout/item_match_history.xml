<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_match_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Top: avatars + names + score -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/avatarMe"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_blue"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="A"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0D1B2A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="You"/>

            <TextView
                android:id="@+id/txtMyRuns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="12 runs"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="VS"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtOpponentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0D1B2A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="sonu"/>

            <TextView
                android:id="@+id/txtOpponentRuns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="11 runs"/>
        </LinearLayout>

        <TextView
            android:id="@+id/avatarOpponent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_red"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="S"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#11000000"/>

    <!-- Bottom: badge + mode + date + chevron -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/badgeResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_won"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#1B5E20"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="WON"/>

        <TextView
            android:id="@+id/txtMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#546E7A"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="RANKED"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txtWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90A4AE"
            android:textSize="11sp"
            tools:text="2h ago"/>

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#90A4AE"
            android:contentDescription="@null"/>
    </LinearLayout>
</LinearLayout>
