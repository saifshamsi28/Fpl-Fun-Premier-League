<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ball_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <!-- Ball # -->
    <TextView
        android:id="@+id/txtBallNo"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:textColor="#90A4AE"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="B1"/>

    <!-- Batter pick -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pickBatter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_pick_blue"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="4"/>

        <TextView
            android:id="@+id/txtBatterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#0D1B2A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="anwar"/>
    </LinearLayout>

    <!-- Bowler pick -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtBowlerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#0D1B2A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="saif"/>

        <TextView
            android:id="@+id/pickBowler"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_pick_red"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="2"/>
    </LinearLayout>

    <!-- Result -->
    <TextView
        android:id="@+id/txtOutcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_wicket_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:minWidth="56dp"
        android:gravity="center"
        tools:text="+4"/>
</LinearLayout>
