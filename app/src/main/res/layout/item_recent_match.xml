<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_match_card"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- You -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtMyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0D1B2A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="You"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtMyTeam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#546E7A"
            android:textSize="11sp"
            android:text="MUMBAI"/>
    </LinearLayout>

    <!-- Score -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/txtScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0D1B2A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="12 - 11"/>

        <TextView
            android:id="@+id/txtWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#90A4AE"
            android:textSize="10sp"
            android:text="just now"/>
    </LinearLayout>

    <!-- Opponent + badge -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/txtOpponentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0D1B2A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="sonu"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/txtResultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_badge_won"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="#1B5E20"
            android:textSize="10sp"
            android:textStyle="bold"
            android:text="WON"/>
    </LinearLayout>
</LinearLayout>
