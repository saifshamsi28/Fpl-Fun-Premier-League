<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result_dark"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle_dark"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:contentDescription="close"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="FPL HAND CRICKET"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"/>

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle_dark"
            android:padding="10dp"
            android:src="@drawable/ic_share"
            android:contentDescription="share"/>
    </LinearLayout>

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/resultContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- ── Result banner ── -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_winner_banner"
                android:gravity="center"
                android:paddingVertical="22dp"
                android:text="YOU WON"
                android:textColor="#1A0A00"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                tools:ignore="HardcodedText"/>

            <!-- ── Score comparison card ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_score_pair_card"
                android:orientation="horizontal">

                <!-- P1 score (blue) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_card_blue"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="20dp"
                    android:layout_margin="10dp">

                    <TextView
                        android:id="@+id/tvP1Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#93C5FD"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        tools:text="SAIF"/>

                    <TextView
                        android:id="@+id/tvP1Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#F1F5F9"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="12"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="runs"
                        android:textColor="#60A5FA"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"/>
                </LinearLayout>

                <!-- P2 score (red) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_card_red"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="20dp"
                    android:layout_margin="10dp">

                    <TextView
                        android:id="@+id/tvP2Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FCA5A5"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        tools:text="ANWAR"/>

                    <TextView
                        android:id="@+id/tvP2Score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#F1F5F9"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="11"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="runs"
                        android:textColor="#F87171"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Hidden views required by ResultActivity ── -->
            <!-- These are set by renderHeader() but not shown in the redesigned UI -->
            <TextView android:id="@+id/tvFinalP1Name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"/>
            <TextView android:id="@+id/tvFinalP1Runs"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"/>
            <TextView android:id="@+id/tvFinalP2Name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"/>
            <TextView android:id="@+id/tvFinalP2Runs"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone"/>

            <!-- ── Ball tracking (hidden by default per product brief) ── -->
            <!-- Code in ResultActivity can still populate these if needed -->
            <TextView
                android:id="@+id/labelInnings1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInnings1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/labelInnings2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInnings2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Continue button -->
    <TextView
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_continue_btn"
        android:gravity="center"
        android:text="CONTINUE"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:clickable="true"
        android:focusable="true"/>
</LinearLayout>
