<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_leaderboard_row"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="11dp">

    <TextView
        android:id="@+id/txtRank"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="#4"
        android:textColor="#DDEBFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtName"
        android:layout_width="214dp"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:textColor="#F7FBFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtRate"
        android:layout_width="102dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:textColor="#D6E7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtPlayed"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:textColor="#D6E7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtWon"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:textColor="#D6E7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtRuns"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:textColor="#D6E7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtTeam"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:textColor="#D6E7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtCity"
        android:layout_width="126dp"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:textColor="#D6E7FF"
        android:textSize="13sp" />

</LinearLayout>
